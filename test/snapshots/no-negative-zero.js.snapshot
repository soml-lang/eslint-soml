exports[`invalid(1): a: -0.0 1`] = `

  1 | a: -0.0

`;

exports[`invalid(1): a: -0.0 2`] = `

Message:
> 1 | a: -0.0
    |    ^^^^ Zero has no sign. \`-0.0\` is the same value as \`0.0\`.

Output:
  1 | a: 0.0

`;

