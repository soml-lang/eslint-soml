{
	"name": "eslint-soml",
	"version": "0.0.5",
	"description": "ESLint plugin for SOML, a config format for humans",
	"license": "MIT",
	"repository": "github:soml-lang/eslint-soml",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"scripts": {
		"create-rule": "node ./scripts/create-rule.js && npm run create-rules-index-file && npm run fix:eslint-docs",
		"create-rules-index-file": "node ./scripts/create-rules-index-file.js",
		"fix": "run-p --continue-on-error \"fix:*\"",
		"fix:eslint-docs": "eslint-doc-generator",
		"fix:js": "eslint --fix",
		"fix:markdown": "markdownlint --fix \"**/*.md\"",
		"fix:snapshots": "node --test --test-update-snapshots \"test/*.js\"",
		"lint": "run-p --continue-on-error \"lint:*\"",
		"lint:eslint-docs": "eslint-doc-generator --check",
		"lint:js": "eslint",
		"lint:markdown": "markdownlint \"**/*.md\"",
		"rename-rule": "node ./scripts/rename-rule.js && npm run create-rules-index-file && npm run fix:eslint-docs",
		"sync-conformance": "node ./scripts/sync-conformance.js",
		"test": "run-s --continue-on-error lint test:js test:types",
		"test:js": "node --test \"test/*.js\"",
		"test:types": "tsc --project test/types/tsconfig.json"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"language",
		"rules"
	],
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"soml",
		"config",
		"configuration",
		"linter",
		"lint",
		"style"
	],
	"dependencies": {
		"@eslint/core": "^1.2.1",
		"@eslint/plugin-kit": "^0.7.3",
		"soml-lang": "^0.0.7"
	},
	"devDependencies": {
		"@babel/code-frame": "^8.0.6",
		"@eslint-community/eslint-utils": "^4.10.1",
		"@typescript-eslint/types": "^8.71.2",
		"enquirer": "^2.4.1",
		"eslint": "^10.13.0",
		"eslint-config-xo": "^7.0.0",
		"eslint-doc-generator": "^3.7.1",
		"eslint-plugin-eslint-plugin": "^7.6.2",
		"eslint-plugin-jsdoc": "^65.3.11",
		"indent-string": "^5.0.0",
		"markdownlint-cli": "^0.50.0",
		"nano-spawn": "^2.1.0",
		"node-style-text": "^2.1.2",
		"npm-run-all2": "^9.0.3",
		"open-editor": "^6.0.0",
		"outdent": "^0.8.0",
		"typescript": "^6.0.3",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"eslint": ">=10.4"
	}
}
